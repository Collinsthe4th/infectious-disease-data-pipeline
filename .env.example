# Copy to .env and adjust. Docker Compose already sets DATABASE_URL for its containers.
DATABASE_URL=postgresql+psycopg://pipeline:pipeline@localhost:5432/disease_surveillance

# Crawler politeness (Section 3.4.3)
REQUEST_DELAY_S=5
REQUEST_TIMEOUT_S=60
MAX_RETRIES=3

# Study window
STUDY_START_YEAR=2021
STUDY_END_YEAR=2026

# Forecasting (Lassa fever, national = NG; add state p-codes e.g. NG029 for Ondo)
FORECAST_DISEASE=LASSA
FORECAST_LOCATIONS=NG
EVALUATION_WEEKS=52
